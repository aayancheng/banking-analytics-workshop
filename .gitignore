.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# Data AND model artifacts are COMMITTED at every stage on purpose:
# every checkpoint is self-sufficient (labs regenerate them, tags guarantee them).

# Demo assets DERIVED from that committed data + the trained scorecard.
# Regenerate with: python workshop/demo/capture_assets.py
workshop/demo/assets/s1_portfolio.png
workshop/demo/assets/s2_score_distribution.png
workshop/demo/assets/s4_watchlist.png
workshop/demo/frames/concat.txt
# Narration build intermediates. The RECORDINGS in workshop/demo/audio/ are source
# and ARE committed — they cannot be regenerated.
workshop/demo/frames/narration.wav
workshop/demo/frames/silent.mp4
workshop/demo/frames/narration/

# Rendered slides: the .html is COMMITTED beside its .md, like workshop/reading/.
# A Codespace has no `open` and no file:// — an uncommitted deck means `make slides`
# plus a forwarded port before you can read a slide. Regenerate with `make slides`;
# it is derived from the .md in the same commit, so re-render when you edit one.
workshop/slides/*.pdf

# Attendee lists and form exports — PII, and this repo is PUBLIC.
# Keep the real list outside the repo; the email/.ics templates use placeholders.
workshop/facilitator/*.csv
workshop/facilitator/attendees*
# Form exports land wherever they're downloaded — catch them anywhere in the tree.
*Submissions*.csv
# Address corrections keyed by attendee email — same PII, same rule (see cohort.py).
workshop/facilitator/email_fixes.json
**/attendees*.csv
# Session and dry-run recordings — large, and they contain people. Keep them out.
workshop/facilitator/*.mp4
workshop/facilitator/*.m4a
workshop/facilitator/*.mov
workshop/facilitator/recordings/

# AC-1 lab output. The prompt card tells each student's agent to write
# reports/audit_AC1.md, so this is per-student work, not repo content — and one
# committed sample would read as the reference answer to a lab whose whole point is
# that YOU review the agent.
reports/audit_AC1*.md
