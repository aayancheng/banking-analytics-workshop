# Data AND model artifacts are COMMITTED at every stage on purpose:
# every checkpoint is self-sufficient (labs regenerate them, tags guarantee them).

# Demo assets DERIVED from that committed data + the trained scorecard.
# Regenerate with: python workshop/demo/capture_assets.py
workshop/demo/assets/s1_portfolio.png
workshop/demo/assets/s2_score_distribution.png
workshop/demo/assets/s4_watchlist.png
workshop/demo/frames/concat.txt
# Narration build intermediates. The RECORDINGS in workshop/demo/audio/ are source
# and ARE committed — they cannot be regenerated.
workshop/demo/frames/narration.wav
workshop/demo/frames/silent.mp4
workshop/demo/frames/narration/

# Rendered slides (instructor-only; regenerate with marp-cli)
workshop/slides/*.html
workshop/slides/*.pdf

# Attendee lists and form exports — PII, and this repo is PUBLIC.
# Keep the real list outside the repo; the email/.ics templates use placeholders.
workshop/facilitator/*.csv
workshop/facilitator/attendees*
