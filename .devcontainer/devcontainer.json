{
  "name": "banking-analytics-workshop",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "postCreateCommand": "make setup && make verify",
  "forwardPorts": [8100, 5180],
  // `make setup` installs into .venv, so put it first on PATH: bare `python`
  // is then the venv's python and `python verify.py` works exactly as the
  // README, the slides and the demo video all promise.
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        // Renders ```mermaid fenced blocks in notebook markdown cells (the S3_4
        // notebook's four flowcharts). VS Code 1.121+ (May 2026) does this natively,
        // but a Codespace's web client can lag that; this extension covers the gap
        // on any version and is a no-op once native support is active.
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
